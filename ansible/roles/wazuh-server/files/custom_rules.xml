<!-- ============================================================ -->
<!-- custom_rules.xml                                             -->
<!-- Règles de détection SOC-as-Service — PFS 2026               -->
<!-- Champs valides Wazuh : match, regex, url, id, srcip, status -->
<!-- ============================================================ -->
<group name="soc_custom,">

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- WEB ATTACKS — SQL Injection / XSS / LFI / RFI             -->
  <!-- Basé sur les logs Apache/Nginx décodés (decoder: web-log) -->
  <!-- ══════════════════════════════════════════════════════════ -->

  <!-- SQL Injection patterns dans l'URL -->
  <rule id="100001" level="10">
    <if_sid>31103</if_sid>
    <url>union select|union+select|select.*from|insert into|drop table|delete from|exec xp_|exec sp_|cast\(|convert\(|char\(|nchar\(|varchar\(|group by|order by|having 1</url>
    <description>SOC | SQL Injection attempt detected in web request</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,sql_injection,attack,</group>
  </rule>

  <!-- SQL Injection repeat - brute -->
  <rule id="100002" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100001</if_matched_sid>
    <same_source_ip />
    <description>SOC | SQL Injection brute-force — multiple attempts from same IP</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,sql_injection,attack,</group>
  </rule>

  <!-- XSS patterns -->
  <rule id="100003" level="8">
    <if_sid>31103</if_sid>
    <url>script>|javascript:|onerror=|onload=|eval\(|document\.cookie|alert\(|&lt;script|%3cscript</url>
    <description>SOC | XSS (Cross-Site Scripting) attempt detected</description>
    <mitre>
      <id>T1059.007</id>
    </mitre>
    <group>web,xss,attack,</group>
  </rule>

  <!-- LFI / Path Traversal -->
  <rule id="100004" level="9">
    <if_sid>31103</if_sid>
    <url>\.\./|\.\./|%2e%2e%2f|%252e%252e|/etc/passwd|/etc/shadow|/proc/self|/var/log|/etc/hosts</url>
    <description>SOC | Local File Inclusion / Path Traversal attempt detected</description>
    <mitre>
      <id>T1083</id>
    </mitre>
    <group>web,lfi,attack,</group>
  </rule>

  <!-- Web Scanner Detection -->
  <rule id="100005" level="8">
    <if_sid>31103</if_sid>
    <match>nikto|sqlmap|dirbuster|gobuster|wfuzz|masscan|nessus|openvas|w3af|skipfish</match>
    <description>SOC | Web vulnerability scanner detected in User-Agent or request</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>web,scanner,recon,</group>
  </rule>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- BRUTE FORCE — Seuils personnalisés                         -->
  <!-- ══════════════════════════════════════════════════════════ -->

  <!-- SSH Brute Force — 5 tentatives en 60s -->
  <rule id="100010" level="12" frequency="5" timeframe="60">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SOC | SSH Brute Force Attack — 5+ failures from same IP in 60s</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,pci_dss_11.4,</group>
  </rule>

  <!-- SSH Brute Force sévère — 15 tentatives → Active Response -->
  <rule id="100011" level="15" frequency="15" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SOC | CRITICAL: SSH Brute Force — 15+ failures — Active Response triggered</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,active_response,</group>
  </rule>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- PRIVILEGE ESCALATION                                       -->
  <!-- ══════════════════════════════════════════════════════════ -->

  <!-- Sudo vers root -->
  <rule id="100020" level="12">
    <if_sid>5402</if_sid>
    <match>sudo su|sudo bash|sudo -i|sudo python|sudo perl|sudo ruby|sudo nc|sudo vim|sudo less|sudo more</match>
    <description>SOC | Privilege escalation attempt via sudo shell/interpreter</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>privilege_escalation,sudo,</group>
  </rule>

  <!-- /etc/passwd modification détectée par FIM -->
  <rule id="100021" level="14">
    <if_sid>550,554</if_sid>
    <match>/etc/passwd|/etc/shadow|/etc/sudoers</match>
    <description>SOC | CRITICAL: System authentication file modified</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>privilege_escalation,fim,authentication,</group>
  </rule>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- MALWARE / PERSISTENCE                                      -->
  <!-- ══════════════════════════════════════════════════════════ -->

  <!-- Crontab modification (FIM) -->
  <rule id="100030" level="11">
    <if_sid>550,554</if_sid>
    <match>/etc/cron|/var/spool/cron|/etc/crontab</match>
    <description>SOC | Cron job modified — possible persistence mechanism</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,cron,fim,</group>
  </rule>

  <!-- Reverse shell patterns dans syslog -->
  <rule id="100031" level="14">
    <if_sid>0</if_sid>
    <match>bash -i|nc -e /bin/|ncat -e|python -c.*socket|perl -e.*socket|ruby -rsocket</match>
    <description>SOC | CRITICAL: Reverse shell command detected in system logs</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
    <group>malware,reverse_shell,attack,</group>
  </rule>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- DVWA SPECIFIC                                              -->
  <!-- ══════════════════════════════════════════════════════════ -->

  <!-- Accès aux endpoints vulnérables DVWA -->
  <rule id="100040" level="10">
    <if_sid>31103</if_sid>
    <url>/dvwa/vulnerabilities/exec|/dvwa/vulnerabilities/sqli|/dvwa/vulnerabilities/xss_r|/dvwa/vulnerabilities/fi</url>
    <description>SOC | Attack attempt on DVWA vulnerable endpoint</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,dvwa,attack,</group>
  </rule>

  <!-- Command injection dans DVWA -->
  <rule id="100041" level="13">
    <if_sid>31103</if_sid>
    <url>/dvwa/vulnerabilities/exec</url>
    <match>ip=.*[;&|`]</match>
    <description>SOC | CRITICAL: OS Command Injection on DVWA exec endpoint</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>web,command_injection,dvwa,attack,</group>
  </rule>

  <!-- HTTP 4xx multiple sur DVWA = scan -->
  <rule id="100042" level="8" frequency="20" timeframe="60">
    <if_matched_sid>31103</if_matched_sid>
    <same_source_ip />
    <status>404|403|401</status>
    <description>SOC | Web directory scan detected — multiple 4xx errors from same IP</description>
    <mitre>
      <id>T1595.003</id>
    </mitre>
    <group>web,scanner,recon,</group>
  </rule>

</group>
