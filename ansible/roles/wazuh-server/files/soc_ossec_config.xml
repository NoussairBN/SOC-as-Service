<!-- ANSIBLE MANAGED SOC UPGRADE v3 - DO NOT EDIT MANUALLY -->
<!-- ============================================================ -->
<!-- SOC-as-Service PFS 2026 - Active Response + FIM + Logs      -->
<!-- ============================================================ -->
<ossec_config>

  <!-- Active Response : SSH Brute Force critique (15+ tentatives) = blocage IP 1h -->
  <active-response>
    <command>firewall-drop</command>
    <location>local</location>
    <rules_id>100011</rules_id>
    <timeout>3600</timeout>
  </active-response>

  <!-- Active Response : Brute force Wazuh built-in = blocage IP 30min -->
  <active-response>
    <command>firewall-drop</command>
    <location>local</location>
    <rules_id>5763</rules_id>
    <timeout>1800</timeout>
  </active-response>

  <!-- Active Response : OS Command Injection DVWA (100043) = blocage IP 24h -->
  <active-response>
    <command>firewall-drop</command>
    <location>all</location>
    <rules_id>100043</rules_id>
    <timeout>86400</timeout>
  </active-response>

  <!-- Enhanced FIM : surveillance temps reel des fichiers critiques -->
  <syscheck>
    <directories check_all="yes" realtime="yes" report_changes="yes">/etc/passwd,/etc/shadow,/etc/sudoers</directories>
    <directories check_all="yes" realtime="yes" report_changes="yes">/etc/cron.d,/var/spool/cron,/etc/crontab</directories>
    <directories check_all="yes" realtime="yes">/usr/bin,/usr/sbin,/bin,/sbin</directories>
    <directories check_all="yes" realtime="yes">/var/www,/srv/http,/opt</directories>
    <ignore>/proc</ignore>
    <ignore>/sys</ignore>
    <ignore>/dev</ignore>
  </syscheck>

  <!-- Log Analysis : auth.log sur le manager (les agents ont leur propre ossec.conf) -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/auth.log</location>
  </localfile>

</ossec_config>
