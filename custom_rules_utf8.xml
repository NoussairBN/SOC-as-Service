<!-- ============================================================ -->
<!-- custom_rules.xml                                             -->
<!-- Detection rules - SOC-as-Service PFS 2026                   -->
<!-- MITRE ATT&CK Cloud Matrix v14                               -->
<!--                                                              -->
<!-- Valid Wazuh match fields: match, regex, url, id,            -->
<!-- srcip, status, user, program_name, hostname                 -->
<!-- ============================================================ -->
<group name="soc_custom,">

  <!-- ============================================================ -->
  <!-- WEB ATTACKS - SQL Injection / XSS / LFI                     -->
  <!-- Based on Apache/Nginx logs decoded by the web-log decoder.  -->
  <!-- Rule 31103: web log with HTTP status code extracted.        -->
  <!-- Rule 31100: raw web log line (fallback for POST requests).  -->
  <!-- SQLi payloads may appear in the URL (GET) or in the raw     -->
  <!-- log line (POST body echoed in error/debug output).          -->
  <!-- ============================================================ -->

  <!-- SQL Injection: patterns in the decoded URL field (GET requests) -->
  <!-- Covers the most common SQLi keywords used in DVWA and sqlmap  -->
  <rule id="100001" level="10">
    <if_sid>31100</if_sid>
    <url>union(\+|%20|%09)select|select(\+|%20|%09).*from|insert(\+|%20)into|drop(\+|%20)table|delete(\+|%20)from|exec(\+|%20)(xp_|sp_)|cast\(|convert\(|char\(|nchar\(|varchar\(|benchmark\(|sleep\(|waitfor|0x[0-9a-f]{4,}|' or |' and |1=1|1=2|--(\+|%20)|;--</url>
    <description>SOC | SQL Injection attempt detected in web request URL</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,sql_injection,attack,</group>
  </rule>

  <!-- SQL Injection: patterns in the raw log line (POST requests).  -->
  <!-- When DVWA processes a POST, the query may appear in error     -->
  <!-- output or debug logs captured by the log collector.           -->
  <rule id="100006" level="10">
    <if_sid>31100</if_sid>
    <match>union select|UNION SELECT|union+select|select from|SELECT FROM|insert into|INSERT INTO|drop table|DROP TABLE|' or '1'='1|' OR '1'='1|1=1--| or 1=1|waitfor delay|benchmark\(|sleep\(</match>
    <description>SOC | SQL Injection payload detected in raw web log (POST)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,sql_injection,attack,</group>
  </rule>

  <!-- SQL Injection repeated attempts (brute-force with sqlmap or manual) -->
  <!-- Triggered when the same IP sends 5+ SQLi attempts within 60s       -->
  <rule id="100002" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100001</if_matched_sid>
    <same_source_ip />
    <description>SOC | SQL Injection brute-force: 5+ attempts from the same IP in 60s</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,sql_injection,attack,</group>
  </rule>

  <!-- XSS: Cross-Site Scripting patterns in URL -->
  <!-- Covers reflected XSS attempts on DVWA /vulnerabilities/xss_r -->
  <!-- Level 12 > 100040 (level 10) so this rule takes priority -->
  <rule id="100003" level="12">
    <if_sid>31100</if_sid>
    <match>%3Cscript|%3cscript|script%3E|script%3e|javascript:|onerror=|onload=|onmouseover=|eval%28|document\.cookie|alert%28|prompt%28|confirm%28|%3cimg|%3ciframe|&#x3c;script</match>
    <description>SOC | XSS (Cross-Site Scripting) attempt detected in URL</description>
    <mitre>
      <id>T1059.007</id>
    </mitre>
    <group>web,xss,attack,</group>
  </rule>

  <!-- LFI / Path Traversal: directory traversal and sensitive file access -->
  <!-- Covers encoded variants: %2e%2e, %252e%252e, etc.                  -->
  <!-- Level 11 > 100040 (level 10) so this rule takes priority -->
  <rule id="100004" level="11">
    <if_sid>31100</if_sid>
    <match>%2e%2e%2f|%2e%2e/|\.\./|%252e%252e|%c0%af|%c1%9c|/etc/passwd|/etc/shadow|/etc/hosts|/proc/self|/var/log/|WEB-INF|\.htaccess|\.htpasswd|php://|file://|expect://</match>
    <description>SOC | Local File Inclusion / Path Traversal attempt detected</description>
    <mitre>
      <id>T1083</id>
    </mitre>
    <group>web,lfi,attack,</group>
  </rule>

  <!-- OS Command Injection on DVWA /vulnerabilities/exec          -->
  <!-- Detects shell metacharacters appended to the ip= parameter  -->
  <!-- OS Command Injection via GET (payload visible in URL) -->
  <rule id="100041" level="13">
    <if_sid>31100</if_sid>
    <url>/vulnerabilities/exec</url>
    <match>ip=.*[;&|`$]|ip=.*%3b|ip=.*%7c|ip=.*%26</match>
    <description>SOC | CRITICAL: OS Command Injection on DVWA exec endpoint (GET)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>web,command_injection,dvwa,attack,</group>
  </rule>

  <!-- OS Command Injection via POST — payload in body, not in Apache log      -->
  <!-- POST /vulnerabilities/exec/ fires rule 31108 (Ignored URLs, level 0)   -->
  <!-- We override 31108 for this specific URL to generate a level 13 alert   -->
  <rule id="100043" level="13">
    <if_sid>31108</if_sid>
    <url>/vulnerabilities/exec</url>
    <match>POST</match>
    <description>SOC | CRITICAL: OS Command Injection attempt on DVWA exec endpoint (POST)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>web,command_injection,dvwa,attack,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- DVWA-SPECIFIC RULES                                          -->
  <!-- DVWA is deployed on the client VPC (private subnet).        -->
  <!-- The agent monitors Docker container logs forwarded to       -->
  <!-- /var/log/dvwa-apache.log (apache log format).               -->
  <!-- ============================================================ -->

  <!-- Access to any DVWA vulnerable endpoint -->
  <!-- Any request to /vulnerabilities/* is noteworthy        -->
  <rule id="100040" level="10">
    <if_sid>31100</if_sid>
    <url>/vulnerabilities/exec|/vulnerabilities/sqli|/vulnerabilities/sqli_blind|/vulnerabilities/xss_r|/vulnerabilities/xss_s|/vulnerabilities/xss_d|/vulnerabilities/fi|/vulnerabilities/upload|/vulnerabilities/csrf</url>
    <description>SOC | Attack attempt on DVWA vulnerable endpoint</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,dvwa,attack,</group>
  </rule>

  <!-- Web vulnerability scanner detection via User-Agent string -->
  <!-- sqlmap, nikto, dirbuster, etc. all send distinctive User-Agents -->
  <rule id="100005" level="8">
    <if_sid>31100</if_sid>
    <match>sqlmap|nikto|dirbuster|gobuster|wfuzz|masscan|nessus|openvas|w3af|skipfish|ZAP|burpsuite|havij|acunetix|nmap scripting|python-requests/2\.</match>
    <description>SOC | Web vulnerability scanner detected via User-Agent or request pattern</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>web,scanner,recon,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- BRUTE FORCE - SSH and web authentication                     -->
  <!--                                                              -->
  <!-- SSH failure SIDs in Wazuh 4.x:                             -->
  <!--   5710: sshd authentication failed (password)               -->
  <!--   5716: sshd authentication failed (invalid user)           -->
  <!--   5758: sshd Maximum authentication attempts exceeded        -->
  <!-- Both are matched here to cover all SSH failure scenarios.   -->
  <!-- ============================================================ -->

  <!-- SSH Brute Force: 5+ failures from the same source IP in 60s -->
  <rule id="100010" level="12" frequency="5" timeframe="60">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SOC | SSH Brute Force: 5+ authentication failures from the same IP in 60s</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,pci_dss_11.4,</group>
  </rule>

  <!-- SSH Brute Force critical: 15+ failures in 120s -> Active Response -->
  <!-- This rule triggers the firewall-drop response on the agent.       -->
  <rule id="100011" level="15" frequency="15" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SOC | CRITICAL: SSH Brute Force - 15+ failures - Active Response firewall-drop triggered</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,active_response,</group>
  </rule>

  <!-- SSH maximum attempts exceeded (immediate block) -->
  <rule id="100012" level="12">
    <if_sid>5758</if_sid>
    <description>SOC | SSH max authentication attempts exceeded on this session</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- PRIVILEGE ESCALATION                                         -->
  <!-- Detected via PAM/sudo logs (auth.log) collected by the      -->
  <!-- agent localfile configuration.                              -->
  <!-- ============================================================ -->

  <!-- Sudo privilege escalation via dangerous interpreters or shells -->
  <rule id="100020" level="12">
    <if_sid>5402</if_sid>
    <match>sudo su|sudo bash|sudo sh|sudo -i|sudo -s|sudo python|sudo python3|sudo perl|sudo ruby|sudo nc|sudo ncat|sudo vim|sudo less|sudo more|sudo tee|sudo find|sudo awk|sudo sed</match>
    <description>SOC | Privilege escalation attempt via sudo shell or interpreter</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>privilege_escalation,sudo,</group>
  </rule>

  <!-- Modification of critical authentication files (detected by FIM)  -->
  <!-- FIM realtime monitoring configured in ossec.conf syscheck block  -->
  <rule id="100021" level="14">
    <if_sid>550,554</if_sid>
    <match>/etc/passwd|/etc/shadow|/etc/sudoers|/etc/sudoers.d</match>
    <description>SOC | CRITICAL: System authentication file modified - possible account persistence</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>privilege_escalation,fim,authentication,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- MALWARE AND PERSISTENCE                                      -->
  <!-- ============================================================ -->

  <!-- Cron job modification detected by FIM -->
  <!-- Attackers use cron for persistent command execution         -->
  <rule id="100030" level="11">
    <if_sid>550,554</if_sid>
    <match>/etc/cron|/var/spool/cron|/etc/crontab|/etc/cron.d</match>
    <description>SOC | Cron job modified - possible persistence mechanism</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,cron,fim,</group>
  </rule>

  <!-- Reverse shell patterns in syslog / auth.log                  -->
  <!-- Using if_sid 0 is invalid; we use the syslog parent SID 1002 -->
  <!-- which covers lines from /var/log/syslog and /var/log/auth.log -->
  <rule id="100031" level="14">
    <if_sid>1002</if_sid>
    <match>bash -i|/bin/bash -i|nc -e /bin/|ncat -e /bin/|python -c.*socket|python3 -c.*socket|perl -e.*socket|ruby -rsocket|mkfifo.*nc|/dev/tcp/|/dev/udp/</match>
    <description>SOC | CRITICAL: Reverse shell command pattern detected in system logs</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
    <group>malware,reverse_shell,attack,</group>
  </rule>

  <!-- Web directory scan: 20+ HTTP 4xx errors from the same IP in 60s -->
  <!-- Typical behavior of dirb, gobuster, wfuzz running against DVWA  -->
  <rule id="100042" level="8" frequency="20" timeframe="60">
    <if_matched_sid>31100</if_matched_sid>
    <same_source_ip />
    <status>404|403|401|400</status>
    <description>SOC | Web directory scan detected - 20+ HTTP 4xx errors from the same IP in 60s</description>
    <mitre>
      <id>T1595.003</id>
    </mitre>
    <group>web,scanner,recon,</group>
  </rule>

</group>
